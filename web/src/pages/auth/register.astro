
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Logo from "../../components/Logo.astro";

const title = "Create Account | ModelVerse";
const description = "Create your ModelVerse account.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <main class="register-page">
    <div class="register-ambient-blur"></div>

    <section class="register-card">
      <a href="/" class="brand group" aria-label="ModelVerse home">
        <Logo class="h-9 w-auto shrink-0 transition-transform duration-200 group-hover:scale-105" id="register-logo" variant="icon" />
        <Logo variant="wordmark" class="text-2xl" />
      </a>

      <div class="heading">
        <span class="eyebrow">YOUR CREATIVE SPACE</span>
        <h1>Create your account<span class="heading-dot">.</span></h1>
        <p>Discover, explore, and customize 3D assets with ModelVerse.</p>
      </div>

      <form id="register-form">
        <div class="form-field">
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
        </div>

        <!-- NEW: Account type selection -->
        <div class="form-field">
          <label for="role">Choose account type</label>
          <select id="role" name="role" required>
            <option value="user" selected>User</option>
            <option value="seller">Seller</option>
          </select>
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <div class="input-wrap">
            <input
              id="password"
              name="password"
              type="password"
              placeholder="Create a strong password"
              minlength="12"
              maxlength="128"
              autocomplete="new-password"
              required
            />
            <button
              type="button"
              class="password-toggle"
              id="toggle-password"
              aria-label="Show password"
              aria-pressed="false"
            >Show</button>
          </div>
          <small class="password-hint">
            <span class="hint-dot"></span>
            Use at least 12 characters for a stronger password.
          </small>
        </div>

        <button type="submit" class="submit-button" id="submit-button">
          <span id="button-text">Create account</span>
          <span class="button-arrow" aria-hidden="true">→</span>
        </button>

        <p id="message" class="message" role="status" aria-live="polite"></p>
      </form>

      <div class="login-prompt">
        Already have an account?
        <a href="/auth/login">Log in <span aria-hidden="true">→</span></a>
      </div>

      <div class="card-footer">
        <span class="footer-dot"></span>
        Your next creative project starts here.
      </div>
    </section>

    <p class="page-caption">
      MODELVERSE <span>·</span> 3D ASSET DISCOVERY &amp; CREATION
    </p>
  </main>

  <style>
    .register-page {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 150px);
      padding: 64px 20px 32px;
      overflow: hidden;
      background: #F5F6F0;
      color: #20251D;
    }

    .register-ambient-blur {
      position: absolute;
      top: 15%;
      left: 50%;
      transform: translateX(-50%);
      width: 440px;
      height: 360px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(84, 122, 36, 0.12) 0%, transparent 70%);
      pointer-events: none;
      z-index: -1;
      filter: blur(40px);
    }

    .register-card {
      width: 100%;
      max-width: 460px;
      box-sizing: border-box;
      padding: 38px 38px 30px;
      border: 1px solid #E1E5D9;
      border-radius: 24px;
      background: #FFFFFF;
      color: #20251D;
      box-shadow: 0 20px 60px rgba(32, 37, 29, 0.06);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: #20251D;
      text-decoration: none;
      line-height: 1;
    }

    .heading {
      margin: 28px 0 24px;
    }

    .eyebrow {
      display: inline-block;
      color: #547A24;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      background: none;
    }

    .heading h1 {
      margin: 8px 0 6px;
      color: #20251D;
      font-size: clamp(26px, 5vw, 32px);
      line-height: 1.2;
      letter-spacing: -1.2px;
      font-weight: 800;
    }

    .heading-dot {
      color: #547A24;
      background: none;
    }

    .heading p {
      margin: 0;
      color: #68715F;
      font-size: 14px;
      line-height: 1.6;
    }

    #register-form {
      display: grid;
      gap: 20px;
    }

    .form-field {
      display: grid;
      gap: 8px;
    }

    .form-field label {
      color: #20251D;
      font-size: 13px;
      font-weight: 600;
    }

    .form-field > input,
    .form-field > select {
      width: 100%;
      box-sizing: border-box;
      height: 48px;
      padding: 0 14px;
      border: 1px solid #E1E5D9;
      border-radius: 12px;
      background: #FFFFFF;
      color: #20251D;
      font: inherit;
      font-size: 13px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-field > input:focus,
    .form-field > select:focus {
      border-color: #547A24;
      box-shadow: 0 0 0 3px rgba(84, 122, 36, 0.16);
    }

    .form-field > input::placeholder {
      color: #929B88;
    }

    .input-wrap {
      display: flex;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
      height: 48px;
      border: 1px solid #E1E5D9;
      border-radius: 12px;
      background: #FFFFFF;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrap:focus-within {
      border-color: #547A24;
      box-shadow: 0 0 0 3px rgba(84, 122, 36, 0.16);
    }

    .input-wrap input {
      flex: 1;
      min-width: 0;
      height: 100%;
      box-sizing: border-box;
      padding: 0 12px 0 14px;
      border: 0;
      outline: 0;
      background: transparent;
      color: #20251D;
      font: inherit;
      font-size: 13px;
    }

    .input-wrap input::placeholder {
      color: #929B88;
    }

    .password-toggle {
      flex-shrink: 0;
      margin-right: 8px;
      padding: 6px 12px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: #547A24;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.15s;
    }

    .password-toggle:hover {
      background: #E8EEDC;
    }

    .password-hint {
      display: flex;
      align-items: center;
      gap: 7px;
      color: #68715F;
      font-size: 11px;
      line-height: 1.5;
    }

    .hint-dot,
    .footer-dot {
      flex-shrink: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #547A24;
    }

    .submit-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      height: 48px;
      margin-top: 4px;
      padding: 0 18px;
      border: 0;
      border-radius: 12px;
      background: #547A24;
      color: #FFFFFF;
      font: inherit;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(84, 122, 36, 0.22);
      transition: transform 0.2s, opacity 0.2s;
    }

    .submit-button:hover {
      transform: translateY(-1px);
      opacity: 0.94;
    }

    .submit-button:disabled {
      opacity: 0.65;
      cursor: wait;
      transform: none;
    }

    .button-arrow {
      font-size: 18px;
      line-height: 1;
      transition: transform 0.2s;
    }

    .submit-button:hover .button-arrow {
      transform: translateX(3px);
    }

    .message {
      margin: -6px 0 0;
      color: #20251D;
      font-size: 12px;
      line-height: 1.6;
      overflow-wrap: anywhere;
    }

    .message:empty {
      display: none;
    }

    .message.error {
      color: #C84646;
    }

    .message.success {
      color: #547A24;
    }

    .login-prompt {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 5px;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #E1E5D9;
      color: #68715F;
      font-size: 13px;
    }

    .login-prompt a {
      color: #547A24;
      font-weight: 700;
      text-decoration: none;
    }

    .login-prompt a:hover {
      text-decoration: underline;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 22px;
      color: #929B88;
      font-size: 11px;
    }

    .page-caption {
      margin: 24px 0 0;
      color: #929B88;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-align: center;
      background: none;
    }

    .page-caption span {
      padding: 0 4px;
      color: #547A24;
      background: none;
    }

    /* Dark Mode */
    :global(.dark) .register-page {
      background: #171916;
      color: #F2F3ED;
    }

    :global(.dark) .register-ambient-blur {
      background: radial-gradient(circle, rgba(197, 244, 103, 0.08) 0%, transparent 70%);
    }

    :global(.dark) .register-card {
      background: #222720;
      border-color: #343B31;
      color: #F2F3ED;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
    }

    :global(.dark) .brand,
    :global(.dark) .heading h1,
    :global(.dark) .form-field label {
      color: #F2F3ED;
    }

    :global(.dark) .eyebrow,
    :global(.dark) .heading-dot,
    :global(.dark) .page-caption span {
      color: #C5F467;
      background: none;
    }

    :global(.dark) .hint-dot,
    :global(.dark) .footer-dot {
      background: #C5F467;
    }

    :global(.dark) .heading p,
    :global(.dark) .password-hint,
    :global(.dark) .login-prompt,
    :global(.dark) .card-footer,
    :global(.dark) .page-caption {
      color: #A3AA9A;
    }

    :global(.dark) .form-field > input,
    :global(.dark) .form-field > select,
    :global(.dark) .input-wrap {
      background: #171916;
      border-color: #343B31;
    }

    :global(.dark) .form-field > input:focus,
    :global(.dark) .form-field > select:focus,
    :global(.dark) .input-wrap:focus-within {
      background: #171916;
      border-color: #C5F467;
      box-shadow: 0 0 0 3px rgba(197, 244, 103, 0.2);
    }

    :global(.dark) .form-field > input,
    :global(.dark) .form-field > select,
    :global(.dark) .input-wrap input {
      color: #F2F3ED;
    }

    :global(.dark) .form-field > input::placeholder,
    :global(.dark) .input-wrap input::placeholder {
      color: #68715F;
    }

    :global(.dark) .password-toggle,
    :global(.dark) .login-prompt a {
      color: #C5F467;
    }

    :global(.dark) .password-toggle:hover {
      background: #292F25;
    }

    :global(.dark) .login-prompt {
      border-color: #343B31;
    }

    :global(.dark) .message {
      color: #F2F3ED;
    }

    :global(.dark) .message.error {
      color: #F17878;
    }

    :global(.dark) .message.success {
      color: #78C995;
    }

    :global(.dark) .submit-button {
      background: #C5F467;
      color: #171916;
      box-shadow: 0 4px 14px rgba(197, 244, 103, 0.2);
    }

    @media (max-width: 520px) {
      .register-page {
        min-height: 0;
        padding: 36px 16px 24px;
      }

      .register-card {
        padding: 26px 20px 22px;
        border-radius: 20px;
      }
    }
  </style>

  <script>
    const form = document.querySelector<HTMLFormElement>("#register-form");
    const message = document.querySelector<HTMLElement>("#message");
    const submitButton = document.querySelector<HTMLButtonElement>("#submit-button");
    const buttonText = document.querySelector<HTMLElement>("#button-text");
    const passwordInput = document.querySelector<HTMLInputElement>("#password");
    const togglePassword = document.querySelector<HTMLButtonElement>("#toggle-password");

    togglePassword?.addEventListener("click", () => {
      if (!passwordInput || !togglePassword) return;

      const showPassword = passwordInput.type === "password";
      passwordInput.type = showPassword ? "text" : "password";
      togglePassword.textContent = showPassword ? "Hide" : "Show";
      togglePassword.setAttribute(
        "aria-label",
        showPassword ? "Hide password" : "Show password"
      );
      togglePassword.setAttribute("aria-pressed", String(showPassword));
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.reportValidity() || !message || !submitButton || !buttonText) return;

      message.textContent = "Creating your account…";
      message.className = "message";
      submitButton.disabled = true;
      buttonText.textContent = "Creating account…";

      const data = new FormData(form);

      try {
        const response = await fetch("/auth/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: data.get("email"),
            password: data.get("password"),
            role: data.get("role"),
          }),
          credentials: "include",
        });

        const result = await response.json();

        if (!response.ok) {
          message.textContent = result.error ?? "Registration failed. Please try again.";
          message.className = "message error";
          return;
        }

        message.textContent = "Account created successfully. Redirecting…";
        message.className = "message success";

        const redirectParam = new URLSearchParams(window.location.search).get("redirect");
        let target = "/dashboard";

        if (result.user?.role === "seller") {
          target = "/seller/dashboard";
        } else if (redirectParam && redirectParam.startsWith("/") &&
          !redirectParam.startsWith("/admin") &&
          !redirectParam.startsWith("/seller")) {
          target = redirectParam;
        }

        window.location.href = target;
      } catch {
        message.textContent =
          "Could not connect to the server. Please make sure the API is running.";
        message.className = "message error";
      } finally {
        submitButton.disabled = false;
        buttonText.textContent = "Create account";
      }
    });
  </script>
</BaseLayout>
