---
import Logo from "./Logo.astro";
import { SITE, SOURCE_COUNT } from "@/lib/site";
const cols = [
  {
    title: "Platform",
    links: [
      ["Explore 3D Assets", "/search"],
      ["3D Browser Editor", "/editor"],
      ["Curated Collections", "/assets"],
      ["Supported Sources", "/docs/sources"],
      ["Platform Stats", "/stats"],
      ["About ModelVerse", "/about"],
      ["Privacy Policy", "/privacy"],
    ],
  },
  {
    title: "Developers & MCP",
    links: [
      ["Quick Start Guide", "/docs"],
      ["Coding Agents & MCP", "/docs/mcp"],
      ["REST API Reference", "/docs/api/reference"],
      ["API Playground", "/docs/api/playground"],
      ["CLI Tool", "/docs/cli"],
      ["Self-Hosting", "/docs/self-hosting"],
    ],
  },
  {
    title: "For AI Agents",
    links: [
      ["AGENTS.md", "/AGENTS.md"],
      ["llms.txt", "/llms.txt"],
      ["llms-full.txt", "/llms-full.txt"],
      ["OpenAPI Spec", "/openapi.json"],
    ],
  },
];
---
<footer class="border-t border-border/70 bg-card/40 transition-colors">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="space-y-4">
      <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-lg">
        <Logo class="size-6" id="logo-footer" />
        <span>Model<span class="bg-gradient-to-r from-primary to-brand-2 bg-clip-text text-transparent">Verse</span></span>
      </a>
      <p class="max-w-xs text-sm text-muted-foreground leading-relaxed">
        Discover, preview, and customize 3D assets from {SOURCE_COUNT} supported repositories across the web — all in one creative workspace.
      </p>
      <div class="flex items-center gap-2 pt-1">
        <a href="/editor" class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary hover:bg-primary/20 transition">
          Launch 3D Studio →
        </a>
      </div>
    </div>
    {cols.map((c) => (
      <div>
        <h2 class="mb-3 text-sm font-medium">{c.title}</h2>
        <ul class="space-y-2 text-sm text-muted-foreground">
          {c.links.map(([label, href]) => <li><a class="transition-colors hover:text-foreground" href={href}>{label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-5 text-xs text-muted-foreground sm:px-6">
      <p>Assets belong to their creators. Always check each asset's licence before use.</p>
      <p><a href={SITE.repo} class="hover:text-foreground" rel="noopener">Open source on GitHub</a></p>
    </div>
  </div>
</footer>
