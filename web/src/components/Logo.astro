---
interface Props { class?: string; id?: string }
const { class: className = "size-7", id = "modelverse-logo" } = Astro.props;
const grad1 = `${id}-grad1`;
const grad2 = `${id}-grad2`;
---
<svg class={className} viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id={grad1} x1="2" y1="2" x2="34" y2="34" gradientUnits="userSpaceOnUse">
      <stop stop-color="#7c3aed" />
      <stop offset="0.5" stop-color="#6366f1" />
      <stop offset="1" stop-color="#06b6d4" />
    </linearGradient>
    <linearGradient id={grad2} x1="18" y1="4" x2="18" y2="32" gradientUnits="userSpaceOnUse">
      <stop stop-color="#a855f7" />
      <stop offset="1" stop-color="#3b82f6" />
    </linearGradient>
    <filter id={`${id}-glow`} x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#6366f1" flood-opacity="0.35" />
    </filter>
  </defs>
  <!-- Top Face -->
  <path d="M18 3.5L31 11L18 18.5L5 11L18 3.5Z" fill={`url(#${grad1})`} fill-opacity="0.95" />
  <!-- Left Face -->
  <path d="M5 11L18 18.5V32.5L5 25V11Z" fill={`url(#${grad2})`} fill-opacity="0.8" />
  <!-- Right Face -->
  <path d="M18 18.5L31 11V25L18 32.5V18.5Z" fill={`url(#${grad1})`} fill-opacity="0.65" />
  <!-- Dynamic Creative Lines -->
  <path d="M18 3.5L31 11M18 18.5L5 11M18 18.5V32.5M18 18.5L31 11" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.7" />
  <!-- Core Vertex Accent -->
  <circle cx="18" cy="18.5" r="2.2" fill="#ffffff" filter={`url(#${id}-glow)`} />
</svg>

