---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { NAV } from "@/lib/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const matches = NAV.filter((i) =>
  i.href === "/docs"
    ? path === "/docs"
    : path === i.href || path.startsWith(i.href + "/")
);
const current = matches.sort((a, b) => b.href.length - a.href.length)[0]?.href;
const active = (href: string) => href === current;
---

<header class="site-header sticky top-0 z-40 border-b border-border/70 bg-background/95 backdrop-blur-xl">
  <div class="header-inner mx-auto flex h-[76px] max-w-[1600px] items-center px-6 lg:px-10">
    <!-- Brand -->
    <a
      href="/"
      class="brand-link group flex shrink-0 items-center gap-3 font-bold tracking-tight text-foreground"
      aria-label="ModelVerse home"
    >
      <span class="brand-icon flex size-10 items-center justify-center rounded-xl bg-gradient-to-tr from-primary/15 via-primary/5 to-brand-2/15 transition group-hover:scale-105">
        <Logo class="size-7" id="header-logo" />
      </span>

      <span class="flex items-center text-[21px] font-black tracking-tight">
        <span>Model</span>
        <span class="bg-gradient-to-r from-primary via-indigo-600 to-brand-2 bg-clip-text text-transparent">Verse</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav hidden items-center text-sm font-medium xl:flex" aria-label="Main navigation">
      {NAV.map((item) => {
        const isCurrent = active(item.href);
        const isEditor = item.href === "/editor";

        return (
          <a
            href={item.href}
            aria-current={isCurrent ? "page" : undefined}
            class:list={[
              "nav-link relative inline-flex shrink-0 items-center justify-center gap-1.5 rounded-full px-3 py-2 transition-colors duration-200",
              isCurrent
                ? "bg-primary/10 font-semibold text-primary"
                : "text-muted-foreground hover:bg-accent hover:text-foreground",
            ]}
          >
            <span>{item.label}</span>

            {isEditor && (
              <span class="rounded-full bg-gradient-to-r from-primary to-brand-2 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white">
                New
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions ml-auto flex shrink-0 items-center">
      <!-- Search -->
      <a
        href="/search"
        class="search-link hidden items-center gap-2 rounded-full border border-border bg-background px-3.5 py-2 text-xs text-muted-foreground transition hover:border-primary/50 hover:bg-accent hover:text-foreground 2xl:inline-flex"
        aria-label="Search 3D assets"
      >
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <span>Search assets...</span>
        <kbd class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px]">⌘K</kbd>
      </a>

      <!-- 3D Studio -->
      <a
        href="/editor"
        class="studio-link hidden items-center justify-center gap-2 rounded-full bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-sm transition hover:-translate-y-0.5 hover:shadow-md hover:shadow-primary/20 lg:inline-flex"
      >
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z" />
          <path d="m3.3 7 8.7 5 8.7-5" />
          <path d="M12 22V12" />
        </svg>
        <span>Open 3D Studio</span>
      </a>

      <!-- Authentication -->
      <div class="auth-actions flex shrink-0 items-center text-sm font-semibold">
        <a
          id="header-login"
          href="/auth/login"
          class="login-link rounded-full px-3.5 py-2.5 text-muted-foreground transition hover:bg-accent hover:text-foreground"
        >
          Log in
        </a>

        <a
          id="header-register"
          href="/auth/register"
          class="register-link rounded-full bg-primary px-4 py-2.5 text-primary-foreground shadow-sm transition hover:-translate-y-0.5 hover:opacity-90"
        >
          Sign up
        </a>

        <span id="header-user" class="hidden max-w-32 truncate text-sm text-muted-foreground"></span>

        <button
          id="header-logout"
          type="button"
          class="hidden rounded-full border border-border px-3.5 py-2.5 text-sm transition hover:bg-accent"
        >
          Log out
        </button>
      </div>

      <!-- Theme Toggle -->
      <div class="theme-control shrink-0">
        <ThemeToggle />
      </div>

      <!-- Mobile Navigation -->
      <details class="mobile-menu relative xl:hidden">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-muted-foreground transition hover:bg-accent hover:text-foreground [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>

        <div class="mobile-panel absolute right-0 top-[calc(100%+12px)] z-50 w-[min(320px,calc(100vw-32px))] rounded-2xl border border-border bg-background p-4 shadow-2xl">
          <div class="mb-3 flex items-center justify-between border-b border-border/70 px-1 pb-3">
            <span class="text-sm font-semibold text-foreground">Navigation</span>
            <span class="text-xs font-semibold text-primary">ModelVerse</span>
          </div>

          <nav class="space-y-1" aria-label="Mobile navigation">
            {NAV.map((item) => (
              <a
                href={item.href}
                aria-current={active(item.href) ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium transition",
                  active(item.href)
                    ? "bg-primary/10 font-semibold text-primary"
                    : "text-muted-foreground hover:bg-accent hover:text-foreground",
                ]}
              >
                <span>{item.label}</span>
                {item.href === "/editor" && (
                  <span class="rounded-full bg-primary/10 px-2 py-1 text-[10px] font-semibold text-primary">New</span>
                )}
              </a>
            ))}
          </nav>

          <div class="mt-3 grid gap-2 border-t border-border/70 pt-3">
            <a href="/search" class="rounded-xl border border-border px-3 py-2.5 text-center text-sm font-medium text-foreground hover:bg-accent">
              Search 3D assets
            </a>
            <a href="/editor" class="rounded-xl bg-primary px-3 py-2.5 text-center text-sm font-semibold text-primary-foreground">
              Launch 3D Studio
            </a>
            <a href="/auth/login" class="rounded-xl px-3 py-2.5 text-center text-sm font-medium text-foreground hover:bg-accent">
              Log in
            </a>
            <a href="/auth/register" class="rounded-xl bg-primary/10 px-3 py-2.5 text-center text-sm font-semibold text-primary hover:bg-primary/15">
              Create an account
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .header-inner {
    gap: clamp(24px, 3vw, 52px);
  }

  .brand-link {
    margin-right: clamp(8px, 1.2vw, 20px);
  }

  .desktop-nav {
    gap: clamp(5px, 0.6vw, 12px);
    flex: 1;
    min-width: 0;
  }

  .nav-link {
    white-space: nowrap;
  }

  .header-actions {
    gap: clamp(12px, 1.5vw, 24px);
  }

  .auth-actions {
    gap: 10px;
  }

  .theme-control {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: -4px;
  }

  .mobile-menu {
    margin-left: 2px;
  }

  @media (min-width: 1280px) {
    .header-inner {
      gap: 24px;
    }

    .brand-link {
      margin-right: 0;
    }

    .desktop-nav {
      gap: 4px;
    }

    .nav-link {
      padding-right: 10px;
      padding-left: 10px;
    }

    .header-actions {
      gap: 12px;
    }

    .auth-actions {
      gap: 6px;
    }
  }

  @media (min-width: 1536px) {
    .header-inner {
      gap: 32px;
    }

    .desktop-nav {
      gap: 8px;
    }

    .nav-link {
      padding-right: 12px;
      padding-left: 12px;
    }

    .header-actions {
      gap: 16px;
    }

    .auth-actions {
      gap: 8px;
    }
  }

  @media (max-width: 1279px) {
    .header-inner {
      gap: 14px;
    }

    .header-actions {
      gap: 10px;
    }
  }

  @media (max-width: 639px) {
    .header-inner {
      height: 64px;
      gap: 10px;
      padding-right: 12px;
      padding-left: 12px;
    }

    .brand-link {
      gap: 8px;
    }

    .brand-icon {
      width: 34px;
      height: 34px;
    }

    .brand-link > span:last-child {
      font-size: 18px;
    }

    .header-actions {
      gap: 6px;
    }

    .auth-actions {
      gap: 2px;
      font-size: 12px;
    }

    .login-link {
      padding-right: 8px;
      padding-left: 8px;
    }

    .register-link {
      padding: 9px 11px;
    }

    .theme-control {
      margin-left: 0;
    }
  }

  @media (max-width: 390px) {
    .brand-link > span:last-child {
      font-size: 16px;
    }

    .brand-icon {
      width: 30px;
      height: 30px;
    }

    .auth-actions {
      gap: 0;
    }

    .login-link {
      padding-right: 6px;
      padding-left: 6px;
    }

    .register-link {
      padding: 8px 9px;
    }

    .header-actions {
      gap: 4px;
    }
  }
</style>

<script>
  const loginLink = document.querySelector<HTMLAnchorElement>("#header-login");
  const registerLink = document.querySelector<HTMLAnchorElement>("#header-register");
  const userLabel = document.querySelector<HTMLElement>("#header-user");
  const logoutButton = document.querySelector<HTMLButtonElement>("#header-logout");

  const authApi = "http://localhost:8787";

  function showLoggedOutState() {
    loginLink?.classList.remove("hidden");
    registerLink?.classList.remove("hidden");
    userLabel?.classList.add("hidden");
    logoutButton?.classList.add("hidden");
  }

  async function refreshAuth() {
    try {
      const response = await fetch(`${authApi}/auth/me`, {
        method: "GET",
        credentials: "include",
      });

      if (!response.ok) {
        showLoggedOutState();
        return;
      }

      const result = await response.json();
      const user = result.user;

      if (!user) {
        showLoggedOutState();
        return;
      }

      loginLink?.classList.add("hidden");
      registerLink?.classList.add("hidden");
      userLabel?.classList.remove("hidden");
      logoutButton?.classList.remove("hidden");

      if (userLabel) {
        userLabel.textContent = user.email || user.id || "Logged in";
        userLabel.title = user.role === "admin" ? "Administrator" : "Signed in";
      }
    } catch (error) {
      console.error("Unable to check login status:", error);
      showLoggedOutState();
    }
  }

  logoutButton?.addEventListener("click", async () => {
    if (logoutButton) logoutButton.disabled = true;

    try {
      const response = await fetch(`${authApi}/auth/logout`, {
        method: "POST",
        credentials: "include",
      });

      if (response.ok) {
        showLoggedOutState();
        window.location.href = "/";
      } else if (logoutButton) {
        logoutButton.disabled = false;
      }
    } catch (error) {
      console.error("Unable to log out:", error);
      if (logoutButton) logoutButton.disabled = false;
    }
  });

  void refreshAuth();
</script>